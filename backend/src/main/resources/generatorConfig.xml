<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration
        PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN"
        "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">

<generatorConfiguration>
    <context id="postgresql" targetRuntime="MyBatis3">
        <!-- 1. Plugins (must come early) -->
        <plugin type="org.mybatis.generator.plugins.SerializablePlugin"/>
        <plugin type="org.mybatis.generator.plugins.ToStringPlugin"/>

        <!-- 2. Optional comment generator -->
        <commentGenerator>
            <property name="suppressDate" value="true"/>
        </commentGenerator>

        <!-- 3. REQUIRED: JDBC Connection -->
        <jdbcConnection driverClass="org.postgresql.Driver"
                        connectionURL="jdbc:postgresql://localhost:5432/dolphinscheduler"
                        userId="root"
                        password="root">
            <property name="nullCatalogMeansCurrent" value="true"/>
            <property name="useInformationSchema" value="true"/>
        </jdbcConnection>

        <!-- 4. Optional type resolver -->
        <javaTypeResolver>
            <property name="forceBigDecimals" value="false"/>
        </javaTypeResolver>

        <!-- 5. REQUIRED: Java Model Generator -->
        <javaModelGenerator targetPackage="com.example.scheduler.model.autoGenerated" targetProject="src/main/java">
            <property name="enableSubPackages" value="true"/>
            <property name="trimStrings" value="true"/>
            <property name="enableSubPackages" value="false" />
        </javaModelGenerator>

        <!-- 6. Optional: SQL Map Generator -->
        <!-- <sqlMapGenerator targetPackage="mapper.autoGenerated" targetProject="src/main/resources">
            <property name="enableSubPackages" value="true"/>
            <property name="enableSubPackages" value="false" />
        </sqlMapGenerator> -->

        <!-- 7. Optional: Java Client Generator (Mapper Interfaces) -->
        <!-- <javaClientGenerator type="XMLMAPPER" targetPackage="com.example.scheduler.mapper.autoGenerated" targetProject="src/main/java">
            <property name="enableSubPackages" value="true"/>
            <property name="enableSubPackages" value="false" />
        </javaClientGenerator> -->

        <!-- 8. REQUIRED: At least one table -->
        <table tableName="diy%" schema="public">
        <!-- Map "public" schema to "main" in Java -->
            <generatedKey column="id" sqlStatement="JDBC" identity="true"/>
            <columnOverride column="created_at" property="createdAt" jdbcType="TIMESTAMP"/>
            <columnOverride column="updated_at" property="updatedAt" jdbcType="TIMESTAMP"/>
        </table>
    </context>
</generatorConfiguration>